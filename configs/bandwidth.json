{
    "experiment_name": "fq-codel-ecn-bandwidth",
    "experiment_group": "bandwidth",

    "sweep": {
        "parameter": "topology.bottleneck_bandwidth",
        "values": [
            "5mbit",
            "10mbit",
            "20mbit"
        ]
    },

    "topology": {
        "bottleneck_bandwidth": "10mbit",
        "bottleneck_delay": "10ms",
