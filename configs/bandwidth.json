        "endpoint_delay": "1ms"
    },

    "qdisc": {
        "limit": 100,
        "flows": 2,
        "target": "5ms",
        "interval": "100ms"
    },

    "traffic": {
        "start_time": 1,
        "duration": 20,
        "number_of_streams": 1
    }
}